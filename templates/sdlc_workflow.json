{
  "key": "sdlc_v1",
  "name": "标准软件研发流程",
  "description": "想法 → 讨论会议 → 建设方案 → 评审会议 → 需求规格 → 需求确认 → 设计 → 任务 → 执行 → 交付；确认点默认人工，可配置为模型判定。",
  "phases": [
    {"key": "idea", "name": "想法"},
    {"key": "discussion", "name": "讨论"},
    {"key": "proposal", "name": "方案"},
    {"key": "review", "name": "多方评价"},
    {"key": "requirement", "name": "需求"},
    {"key": "design", "name": "设计"},
    {"key": "tasks", "name": "任务分解"},
    {"key": "execution", "name": "执行"},
    {"key": "delivery", "name": "交付"}
  ],
  "automation_levels": {
    "L1": {"clarify": "human", "roster": "human", "consensus": "human",
           "proposal": "human", "review": "human", "requirement": "human"},
    "L2": {"clarify": "human", "roster": "human", "consensus": "program",
           "proposal": "human", "review": "human", "requirement": "human"},
    "L3": {"clarify": "proxy", "roster": "auto", "consensus": "program_fallback",
           "proposal": "auto", "review": "model", "requirement": "model"}
  },
  "params": {
    "discussion": {
      "participants_min": {"type": "int", "default": 3, "min": 1, "max": 99, "title": "参会人数下限",
                           "recommend": "3–5", "hint": "建议 3–5 人；超过 10 人收益很小，耗时线性增长"},
      "participants_max": {"type": "int", "default": 5, "min": 1, "max": 99, "title": "参会人数上限",
                           "recommend": "3–5", "hint": "建议 3–5 人；上下限相等即为固定人数"},
      "rounds_max": {"type": "int", "default": 20, "min": 1, "max": 99, "title": "讨论轮次上限",
                     "recommend": "2–5", "hint": "通常 2–5 轮内收敛；这是兜底值"},
      "exchanges_per_point": {"type": "int", "default": 2, "min": 1, "max": 9, "title": "每个决策点的交锋次数（跨轮累计）"},
      "stall_rounds": {"type": "int", "default": 2, "min": 1, "max": 9, "title": "停滞判定轮数",
                       "hint": "连续几轮无人改变立场就进入共识确认点"},
      "proposal_check_rounds": {"type": "int", "default": 2, "min": 1, "max": 9, "title": "方案复核轮次上限"},
      "closure_rule": {"type": "str", "default": "unanimous", "choices": ["unanimous", "no_objection", "facilitator_rules"],
                       "title": "闭合规则"},
      "proxy_enabled": {"type": "bool", "default": false, "title": "启用需求方代理"},
      "full_history": {"type": "bool", "default": false, "title": "全量历史",
                       "hint": "仅供对照实验：每一轮带上此前所有轮次的逐字发言；关闭时为拼装视图"}
    },
    "review": {
      "reviewers_min": {"type": "int", "default": 0, "min": 0, "max": 99, "title": "评审者人数下限",
                        "hint": "0 表示不限制"},
      "reviewers_max": {"type": "int", "default": 0, "min": 0, "max": 99, "title": "评审者人数上限",
                        "hint": "0 表示不限制；建议至少一名评审者绑定不同家族的模型"},
      "pre_brief": {"type": "bool", "default": true, "title": "评审前先写要点"},
      "conference": {"type": "bool", "default": true, "title": "开启会议讨论"},
      "rounds_max": {"type": "int", "default": 3, "min": 1, "max": 9, "title": "复审轮次上限"},
      "min_blocking_severity": {"type": "str", "default": "major", "choices": ["blocker", "major"],
                                "title": "阻塞线"}
    },
    "confirm": {
      "coverage": {"type": "str", "default": "full", "choices": ["full", "partitioned"],
                   "title": "核对覆盖方式"},
      "expected_first": {"type": "bool", "default": true, "title": "先写预期再核对"},
      "rounds_max": {"type": "int", "default": 3, "min": 1, "max": 9, "title": "需求复核轮次上限"},
      "min_blocking_severity": {"type": "str", "default": "major", "choices": ["blocker", "major"],
                                "title": "阻塞线"}
    },
    "gates": {
      "max_auto_rejects": {"type": "int", "default": 2, "min": 1, "max": 9, "title": "模型连续驳回上限"}
    },
    "context": {
      "compact_at": {"type": "float", "default": 0.8, "min": 0.5, "max": 0.95, "title": "压缩触发阈值"},
      "compact_to": {"type": "float", "default": 0.5, "min": 0.2, "max": 0.6, "title": "压缩后目标占用",
                     "hint": "须比触发阈值至少低 20 个百分点"}
    }
  },
  "rubrics": {
    "proposal": "判断这份建设方案是否可以进入需求拆解：目标与成功标准是否明确；范围与不做什么是否写明；每个决策点是否有结论与依据；待确认问题是否已醒目列出。存在待确认问题不构成驳回的理由，它们会由用户在确认点上决定。",
    "review": "判断方案是否可以确认：评审结论须为接受，或有条件接受且文字级修订已经过验证；逐条核对仍有争议的决策级意见是否已妥善处理。",
    "requirement": "判断需求规格是否可以确认：确认结论须为通过；抽查追踪矩阵，确认没有追溯不到决策点的需求，也没有被遗漏的已了结决策点。",
    "artifact": "判断这份工件是否完整、内部一致、可供下一环节直接使用。只依据工件本身与给定的检查单判断。"
  },
  "nodes": [
    {
      "key": "idea", "type": "PASS", "name": "想法录入", "phase": "idea", "deps": [],
      "config": {}
    },
    {
      "key": "discuss", "type": "MEETING", "name": "讨论会议", "phase": "discussion",
      "deps": ["idea"], "assignee": {"role": "facilitator"},
      "config": {"protocol": "discussion", "artifact": "discussion", "timeout_s": 3600}
    },
    {
      "key": "gate_proposal", "type": "HUMAN_GATE", "name": "方案确认", "phase": "proposal",
      "deps": ["discuss"],
      "config": {"artifact": "proposal", "check": "proposal", "title": "方案确认",
                 "description": "确认建设方案：送 AI 评审（默认）、直接通过（跳过评审），或驳回并写明意见。",
                 "routes": [{"key": "skip_review", "label": "直接通过（跳过评审）",
                             "nodes": ["review", "gate_review"],
                             "description": "不经过评审会议，直接进入需求拆解。"}]}
    },
    {
      "key": "review", "type": "MEETING", "name": "评审会议", "phase": "review",
      "deps": ["gate_proposal", "discuss"], "assignee": {"role": "review_chair"},
      "config": {"protocol": "review", "artifact": "review", "timeout_s": 3600,
                 "round": 1, "max_rounds": 3}
    },
    {
      "key": "gate_review", "type": "HUMAN_GATE", "name": "评审裁决", "phase": "review",
      "deps": ["review"],
      "config": {"artifact": "proposal", "check": "review", "title": "评审裁决", "reject_target": "review",
                 "description": "查看方案与评审报告：通过、编辑方案后通过，或驳回。驳回反馈会作为你提出的评审意见进入下一轮。"}
    },
    {
      "key": "requirement", "type": "AGENT", "name": "需求分析师", "phase": "requirement",
      "deps": ["gate_review"], "assignee": {"role": "requirement"},
      "config": {"artifact": "requirement", "inputs": ["proposal", "discussion"],
                 "instruction": "基于已确认的建设方案与决策点账本，产出 EARS 需求规格，并在末尾给出需求追踪矩阵与非需求类决策两张表。"}
    },
    {
      "key": "confirm", "type": "MEETING", "name": "需求确认会议", "phase": "requirement",
      "deps": ["requirement"], "assignee": {"role": "review_chair"},
      "config": {"protocol": "confirm", "artifact": "review", "timeout_s": 3600,
                 "round": 1, "max_rounds": 3}
    },
    {
      "key": "gate_requirement", "type": "HUMAN_GATE", "name": "需求确认", "phase": "requirement",
      "deps": ["confirm"],
      "config": {"artifact": "requirement", "check": "requirement", "title": "需求确认", "reject_target": "confirm",
                 "description": "查看需求规格与确认报告：通过、编辑需求后通过，或驳回。"}
    },
    {
      "key": "design", "type": "AGENT", "name": "系统设计师", "phase": "design",
      "deps": ["gate_requirement"], "assignee": {"role": "design"},
      "config": {"artifact": "design", "inputs": ["requirement", "proposal"],
                 "instruction": "基于需求规格输出编号章节的设计规格。"}
    },
    {
      "key": "gate_design", "type": "HUMAN_GATE", "name": "设计审查", "phase": "design",
      "deps": ["design"],
      "config": {"artifact": "design", "title": "设计审查",
                 "description": "审查设计是否可实施；可直接编辑后通过。"}
    },
    {
      "key": "tasks", "type": "AGENT", "name": "任务分解器", "phase": "tasks",
      "deps": ["gate_design"], "assignee": {"role": "task_breaker"},
      "config": {"artifact": "task", "inputs": ["design"],
                 "instruction": "把设计拆成 2-4 个可并行/可验证的开发任务。"}
    },
    {
      "key": "taskgraph", "type": "TASKGRAPH", "name": "任务图构建", "phase": "tasks",
      "deps": ["tasks"], "config": {"mode": "parse"}
    },
    {
      "key": "gate_tasks", "type": "HUMAN_GATE", "name": "任务图确认", "phase": "tasks",
      "deps": ["taskgraph"],
      "config": {"artifact": "task", "title": "任务图确认",
                 "description": "确认任务依赖与 wave；通过后展开并行开发节点。"}
    },
    {
      "key": "expand_exec", "type": "TASKGRAPH", "name": "展开执行图", "phase": "execution",
      "deps": ["gate_tasks"], "config": {"mode": "expand"}
    },
    {
      "key": "verify", "type": "VERIFY", "name": "测试验证", "phase": "execution",
      "deps": ["expand_exec"],
      "config": {"command": "python -m unittest discover -s . -p \"test_*.py\"",
                 "timeout_s": 180, "dynamic": true}
    },
    {
      "key": "gate_accept", "type": "HUMAN_GATE", "name": "验收确认", "phase": "execution",
      "deps": ["verify"],
      "config": {"title": "验收确认",
                 "description": "确认执行结果与测试证据；通过后生成 changelog。"}
    },
    {
      "key": "delivery", "type": "AGENT", "name": "集成交付", "phase": "delivery",
      "deps": ["gate_accept"], "assignee": {"role": "delivery"},
      "config": {"artifact": "changelog",
                 "inputs": ["proposal", "requirement", "design", "task"],
                 "instruction": "汇总工件链与验证证据，产出 changelog。"}
    }
  ]
}
